      "name": "Owner decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst b = $('Owner action').first().json.body;\nconst c = $input.all().map(i => i.json).find(r => r.conversationId) || {};\nconst amount = Math.round(Number(b.amount ?? c.lastOffer) || 0);\nconst base = { itemId: b.itemId, conversationId: b.conversationId, platform: c.platform || 'marktplaats', buyer: c.buyer || 'Buyer', lastOffer: c.lastOffer ?? null };\nif (b.action === 'accept_offer') return [{ json: { ...base, text: 'Deal, €' + amount + ' is goed! Wanneer wil je het komen ophalen?', state: 'deal', deal: true, price: amount } }];\nif (b.action === 'counter_offer') return [{ json: { ...base, text: 'Voor €' + amount + ' mag je hem hebben.', state: 'open', deal: false, price: amount } }];\nif (b.action === 'reject_offer') return [{ json: { ...base, text: 'Bedankt voor je bod, maar daar ga ik helaas niet mee akkoord.', state: 'declined', deal: false, price: null } }];\nthrow new Error('Unknown action ' + b.action);"
      }
    },
