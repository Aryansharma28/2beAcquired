    {
      "id": "caffd7ba-501c-4044-9b9d-f18c1ab022cc",
      "name": "Post on Marktplaats (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/USER~marktplaats/run-sync-get-dataset-items?timeout=280",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const it = $('Mark publishing').first().json.item; return {\n    action: 'post', title: it.title, description: it.description, price: it.askPrice, categoryHint: it.category,\n    condition: it.condition, delivery: it.delivery, photoUrls: it.photos, dryRun: false }; })()) }}",
        "options": {
          "timeout": 310000
        }
      },
      "executeOnce": true
    },
    {
      "id": "c493494e-65e0-470e-862d-479ff23fece0",
      "name": "Live",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst src = $('Mark publishing').first().json;\nconst res = $input.first().json;\nconst item = src.item;\nitem.listings = (item.listings || []).filter(l => l.platform !== 'marktplaats');\nitem.listings.push({ platform: 'marktplaats', status: res.url ? 'live' : 'error', url: res.url, listingId: String(res.listingId ?? ''), price: item.askPrice, dryRun: !!res.dryRun });\nitem.status = 'live';\nitem.liveAt = new Date().toISOString();\nreturn [{ json: { itemId: src.itemId, status: 'live', data: JSON.stringify(item), title: item.title, url: res.url, price: item.askPrice, count: item.listings.filter(l => l.status === 'live').length } }];"
      }
    },
