    {
      "id": "15a82de2-cb90-4104-b780-42663beb60f7",
      "name": "Mark publishing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst row = $input.all().map(i => i.json).find(r => r.itemId);\nif (!row) throw new Error('Item not found');\nif (!['ad_ready', 'publishing'].includes(row.status)) return [];   // already live / sold: nothing to do\nconst item = JSON.parse(row.data);\nitem.status = 'publishing';\nreturn [{ json: { itemId: row.itemId, status: 'publishing', data: JSON.stringify(item), item } }];"
      }
    },
