      "name": "Summaries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst items = $input.all().map(i => i.json).filter(r => r.itemId).map(r => {\n  const d = JSON.parse(r.data || '{}');\n  return { id: r.itemId, status: r.status, title: d.title || d.name || 'New item', photo: d.photos?.[0], askPrice: d.askPrice,\n           floorPrice: d.floorPrice, goal: d.goal, sale: d.sale, createdAt: d.createdAt,\n           listings: (d.listings || []).map(l => ({ platform: l.platform, status: l.status, url: l.url })) };\n}).sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));\nreturn [{ json: { items } }];"
      }
