        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst deal = $('Deal closed').item.json;\nconst item = JSON.parse($json.data);\nitem.sale = { price: deal.price, platform: deal.platform, buyer: deal.buyer, conversationId: deal.conversationId, ts: new Date().toISOString() };\nitem.status = 'sold';\nreturn { json: { itemId: $json.itemId, data: JSON.stringify(item), item, price: deal.price, buyer: deal.buyer } };"
      }
    },
