      "name": "Listings to remove",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn $('Mark sold').all().flatMap(i => (i.json.item.listings || []).filter(l => l.status === 'live' && l.listingId)\n  .map(l => ({ json: { itemId: i.json.itemId, platform: l.platform, listingId: l.listingId } })));"
      }
    },
