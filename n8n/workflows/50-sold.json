    {
      "id": "97e92edd-a3c7-43ed-a521-5bc86babdc92",
      "name": "All removed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn $('Mark sold').all().map(i => {\n  const item = i.json.item;\n  item.listings = (item.listings || []).map(l => ({ ...l, status: 'removed' }));\n  return { json: { itemId: i.json.itemId, data: JSON.stringify(item), title: item.title, price: i.json.price, platforms: item.listings.length } };\n});"
      }
    },
