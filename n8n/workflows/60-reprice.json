    {
      "id": "54cad32c-144b-40ae-bf07-8cbe3277ab7d",
      "name": "New price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst d = $('Decide').item.json, it = d.item;\nit.askPrice = d.next;\nit.listings = it.listings.map(l => l.platform === 'marktplaats' ? { ...l, price: d.next } : l);\n(it.priceHistory ??= []).push({ ts: new Date().toISOString(), price: d.next, reason: d.reason });\nreturn { json: { itemId: d.itemId, data: JSON.stringify(it), old: d.old, next: d.next, reason: d.reason } };"
      }
    },
