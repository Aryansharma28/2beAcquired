    {
      "id": "d411e371-cf2c-40b5-923e-1204df802829",
      "name": "Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst convs = $('Conversations').all().map(i => i.json);\nconst now = Date.now(), H = 3600e3;\nreturn $('Items').all().map(i => i.json).filter(r => r.status === 'live').flatMap(r => {\n  const it = JSON.parse(r.data);\n  const mp = (it.listings || []).find(l => l.platform === 'marktplaats' && l.status === 'live');\n  if (!mp) return [];\n  const lastChange = Date.parse((it.priceHistory || []).at(-1)?.ts || it.liveAt || it.createdAt);\n  const every = it.goal === 'fast' ? 6 : 24;\n  if ((now - lastChange) < every * H) return [];\n  if (it.askPrice <= it.floorPrice) return [];\n  return [{ json: { itemId: r.itemId, item: it, listing: mp, conversations: convs.filter(c => c.itemId === r.itemId).length, hoursSinceChange: Math.round((now - lastChange) / H) } }];\n});"
      }
    },
    {
      "id": "a8ba0e11-56c6-41b1-9b03-d96d68c8b5e1",
      "name": "Views (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/USER~marktplaats/run-sync-get-dataset-items?timeout=60",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'stats', listingUrl: $json.listing.url }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "94cc1346-051f-4f10-a7af-82f006bc48de",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst c = $('Candidates').item.json, it = c.item;\nconst views = Number($json.views) || 0, favs = Number($json.favorites) || 0;\n// many views but nobody writes → price is the problem → bigger step\nconst step = it.goal === 'fast' ? (views > 40 && !c.conversations ? 0.12 : 0.08) : (views > 60 && !c.conversations ? 0.07 : 0.05);\nlet next = Math.max(it.floorPrice, Math.round(it.askPrice * (1 - step)));\nif (next >= 50) next = Math.max(it.floorPrice, Math.round(next / 5) * 5);\nconst change = next < it.askPrice;\nconst reason = views + ' views, ' + favs + ' saves, ' + c.conversations + ' chats in ' + c.hoursSinceChange + 'h';\nreturn { json: { itemId: c.itemId, listingId: c.listing.listingId, old: it.askPrice, next, change, reason, item: it } };"
      }
    },
    {
      "id": "388c25e1-2f79-4ae8-91d3-bf13753c1bb3",
      "name": "Lower price?",
      "type": "n8n-nodes-base.if",
