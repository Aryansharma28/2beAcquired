        "jsonBody": "={{ JSON.stringify(Object.assign({ topic: \"tba-3e7edc678d63\" }, $json.human\n    ? { title: 'Your selling agent needs you', message: $json.kind === 'captcha' ? 'Marktplaats showed a captcha. Open the login helper once to continue.' : 'Marktplaats session expired. Log in once and I will carry on.', tags: ['warning'], priority: 4 }\n    : { title: 'Agent hit a snag (handling it)', message: $json.workflow + ': ' + $json.msg, tags: ['hammer_and_wrench'], priority: 2 })) }}",
        "options": {}
