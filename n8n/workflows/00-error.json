            "type": "error",
            "text": "={{ $json.human ? 'Needs you: ' : 'Hit a snag, will retry: ' }}{{ $json.kind }} in {{ $json.workflow }} → {{ $json.lastNode }}",
            "meta": "={{ JSON.stringify({ msg: $json.msg, url: $json.url }) }}"
          },
