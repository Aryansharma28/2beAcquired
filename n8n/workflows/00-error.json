    {
      "id": "434a6dce-2d1f-40f0-a6a4-e72423855530",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst e = $json.execution || {};\nconst msg = String(e.error?.message || e.error?.description || 'Unknown error');\nconst lastNode = e.lastNodeExecuted || '';\n// find an itemId anywhere in the failing run's data we were given\nconst blob = JSON.stringify($json).slice(0, 200000);\nconst m = blob.match(/itm_[a-z0-9]{8,14}/);\nconst itemId = m ? m[0] : 'system';\nlet kind = 'transient', human = false;\nif (/SESSION_EXPIRED|login/i.test(msg)) { kind = 'session_expired'; human = true; }\nelse if (/CAPTCHA/i.test(msg)) { kind = 'captcha'; human = true; }\nelse if (/429|rate/i.test(msg)) kind = 'rate_limited';\nreturn [{ json: { itemId, kind, human, msg: msg.slice(0, 300), workflow: $json.workflow?.name, lastNode, url: e.url } }];"
      }
    },
    {
      "id": "66e270b1-aaf9-4cf9-867f-1c574110a931",
      "name": "Log to item",
      "type": "n8n-nodes-base.dataTable",
